        <di:waypoint x="800" y="250" />
        <di:waypoint x="829" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AsIs_Flow_12_di" bpmnElement="AsIs_Flow_12">
        <di:waypoint x="929" y="250" />
        <di:waypoint x="961" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AsIs_Flow_13_di" bpmnElement="AsIs_Flow_13">
        <di:waypoint x="997" y="250" />
        <di:waypoint x="1033" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AsIs_Flow_14_di" bpmnElement="AsIs_Flow_14">
        <di:waypoint x="1083" y="210" />
        <di:waypoint x="1083" y="180" />
      </bpmndi:BPMNEdge>
