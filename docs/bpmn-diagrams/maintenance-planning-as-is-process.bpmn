        <di:waypoint x="249" y="250" />
        <di:waypoint x="281" y="250" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AsIs_Flow_7_di" bpmnElement="AsIs_Flow_7">
        <di:waypoint x="590" y="155" />
