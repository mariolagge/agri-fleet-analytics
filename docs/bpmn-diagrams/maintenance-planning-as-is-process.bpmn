        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AsIs_Flow_9_di" bpmnElement="AsIs_Flow_9">
        <di:waypoint x="800" y="155" />
        <di:waypoint x="1058" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="AsIs_Flow_15_di" bpmnElement="AsIs_Flow_15">
        <di:waypoint x="1108" y="155" />
        <di:waypoint x="1152" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="AsIs_Participant_Workshop_di" bpmnElement="AsIs_Participant_Workshop" isHorizontal="true">
        <dc:Bounds x="151" y="380" width="1089" height="60" />
        <bpmndi:BPMNLabel />
