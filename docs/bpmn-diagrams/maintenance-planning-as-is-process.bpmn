          <dc:Bounds x="191" y="173" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AsIs_Gateway_MergeTriggers_di" bpmnElement="AsIs_Gateway_MergeTriggers" isMarkerVisible="true">
        <dc:Bounds x="411" y="130" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AsIs_Gateway_ServiceDue_di" bpmnElement="AsIs_Gateway_ServiceDue" isMarkerVisible="true">
        <dc:Bounds x="411" y="225" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="467" y="243" width="65" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AsIs_Task_CompareInterval_di" bpmnElement="AsIs_Task_CompareInterval">
        <dc:Bounds x="281" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AsIs_Start_HourMeter_di" bpmnElement="AsIs_Start_HourMeter">
        <dc:Bounds x="213" y="232" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="190" y="278" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AsIs_Task_AssessJob_di" bpmnElement="AsIs_Task_AssessJob">
        <dc:Bounds x="490" y="115" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AsIs_Gateway_DoItMyself_di" bpmnElement="AsIs_Gateway_DoItMyself" isMarkerVisible="true">
        <dc:Bounds x="615" y="130" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="608" y="106" width="64" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AsIs_Task_ServiceOnFarm_di" bpmnElement="AsIs_Task_ServiceOnFarm">
        <dc:Bounds x="700" y="115" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AsIs_Task_DescribeProblem_di" bpmnElement="AsIs_Task_DescribeProblem">
        <dc:Bounds x="700" y="210" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AsIs_End_NoService_di" bpmnElement="AsIs_End_NoService">
        <dc:Bounds x="418" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="464" y="313" width="92" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AsIs_Gateway_MergeOutcomes_di" bpmnElement="AsIs_Gateway_MergeOutcomes" isMarkerVisible="true">
        <dc:Bounds x="1058" y="130" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AsIs_End_MachineInUse_di" bpmnElement="AsIs_End_MachineInUse">
        <dc:Bounds x="1152" y="137" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1130" y="180" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
