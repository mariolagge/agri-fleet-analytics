<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="ToBe_Definitions" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="ToBe_Collaboration">
    <bpmn:participant id="ToBe_Participant_Farmer" name="Farmer" processRef="ToBe_Process_MaintenancePlanning" />
    <bpmn:participant id="ToBe_Participant_AgriFleet" name="AgriFleet Analytics" />
    <bpmn:participant id="ToBe_Participant_Workshop" name="Independent workshop" />
    <bpmn:messageFlow id="ToBe_Message_1" name="Ranking, status, recommendation, live condition" sourceRef="ToBe_Participant_AgriFleet" targetRef="ToBe_Task_CheckFleet" />
    <bpmn:messageFlow id="ToBe_Message_2" name="Flags with counter, value, threshold" sourceRef="ToBe_Participant_AgriFleet" targetRef="ToBe_Task_OpenAssetDetail" />
    <bpmn:messageFlow id="ToBe_Message_3" name="Flag reasons: counter, value, threshold" sourceRef="ToBe_Task_SendFlagReasons" targetRef="ToBe_Participant_Workshop" />
    <bpmn:messageFlow id="ToBe_Message_4" name="Repair finished" sourceRef="ToBe_Participant_Workshop" targetRef="ToBe_Event_MachineRepaired" />
  </bpmn:collaboration>
  <bpmn:process id="ToBe_Process_MaintenancePlanning" isExecutable="false">
    <bpmn:startEvent id="ToBe_Start_Morning" name="Every morning before work">
      <bpmn:outgoing>ToBe_Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:startEvent>
    <bpmn:task id="ToBe_Task_CheckFleet" name="Check fleet ranking and live telemetry strip">
      <bpmn:incoming>ToBe_Flow_1</bpmn:incoming>
      <bpmn:outgoing>ToBe_Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ToBe_Gateway_AssetStatus" name="Asset status?">
      <bpmn:incoming>ToBe_Flow_2</bpmn:incoming>
      <bpmn:outgoing>ToBe_Flow_3</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Flow_4</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="ToBe_Start_ProblemNoticed" name="Problem noticed during work">
      <bpmn:outgoing>ToBe_Flow_7</bpmn:outgoing>
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression" />
      </bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="ToBe_Gateway_MergeCritical">
      <bpmn:incoming>ToBe_Flow_3</bpmn:incoming>
      <bpmn:incoming>ToBe_Flow_7</bpmn:incoming>
      <bpmn:outgoing>ToBe_Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="ToBe_Task_OpenAssetDetail" name="Open asset detail: flags with reasons, live condition">
      <bpmn:incoming>ToBe_Flow_8</bpmn:incoming>
      <bpmn:outgoing>ToBe_Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ToBe_Task_AssessJob" name="Assess job: complexity, tools, time pressure, cost">
      <bpmn:incoming>ToBe_Flow_9</bpmn:incoming>
      <bpmn:outgoing>ToBe_Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ToBe_Gateway_DoItMyself" name="Do it myself?">
      <bpmn:incoming>ToBe_Flow_10</bpmn:incoming>
      <bpmn:outgoing>ToBe_Flow_11</bpmn:outgoing>
      <bpmn:outgoing>ToBe_Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="ToBe_Task_ServiceOnFarm" name="Service or repair machine on the farm">
      <bpmn:incoming>ToBe_Flow_11</bpmn:incoming>
      <bpmn:outgoing>ToBe_Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ToBe_Task_SendFlagReasons" name="Send flag reasons to workshop">
      <bpmn:incoming>ToBe_Flow_13</bpmn:incoming>
      <bpmn:outgoing>ToBe_Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ToBe_Task_BringMachine" name="Bring machine to workshop">
      <bpmn:incoming>ToBe_Flow_14</bpmn:incoming>
      <bpmn:outgoing>ToBe_Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="ToBe_Event_MachineRepaired" name="Machine repaired">
      <bpmn:incoming>ToBe_Flow_15</bpmn:incoming>
      <bpmn:outgoing>ToBe_Flow_16</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="ToBe_Task_CollectMachine" name="Collect machine from workshop">
      <bpmn:incoming>ToBe_Flow_16</bpmn:incoming>
      <bpmn:outgoing>ToBe_Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ToBe_Task_PlanInspection" name="Plan inspection within the next 15–20 engine hours">
      <bpmn:incoming>ToBe_Flow_4</bpmn:incoming>
      <bpmn:outgoing>ToBe_Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="ToBe_Gateway_MergeOutcomes">
      <bpmn:incoming>ToBe_Flow_5</bpmn:incoming>
      <bpmn:incoming>ToBe_Flow_6</bpmn:incoming>
      <bpmn:incoming>ToBe_Flow_12</bpmn:incoming>
      <bpmn:incoming>ToBe_Flow_17</bpmn:incoming>
      <bpmn:outgoing>ToBe_Flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="ToBe_Task_PlanMachineUse" name="Plan machine use from live condition and 24 h flags">
      <bpmn:incoming>ToBe_Flow_18</bpmn:incoming>
      <bpmn:outgoing>ToBe_Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="ToBe_End_UsePlanned" name="Machine use planned">
      <bpmn:incoming>ToBe_Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="ToBe_Flow_1" sourceRef="ToBe_Start_Morning" targetRef="ToBe_Task_CheckFleet" />
    <bpmn:sequenceFlow id="ToBe_Flow_2" sourceRef="ToBe_Task_CheckFleet" targetRef="ToBe_Gateway_AssetStatus" />
    <bpmn:sequenceFlow id="ToBe_Flow_3" name="CRITICAL" sourceRef="ToBe_Gateway_AssetStatus" targetRef="ToBe_Gateway_MergeCritical" />
    <bpmn:sequenceFlow id="ToBe_Flow_4" name="WATCH" sourceRef="ToBe_Gateway_AssetStatus" targetRef="ToBe_Task_PlanInspection" />
    <bpmn:sequenceFlow id="ToBe_Flow_5" sourceRef="ToBe_Task_PlanInspection" targetRef="ToBe_Gateway_MergeOutcomes" />
    <bpmn:sequenceFlow id="ToBe_Flow_6" name="GOOD" sourceRef="ToBe_Gateway_AssetStatus" targetRef="ToBe_Gateway_MergeOutcomes" />
    <bpmn:sequenceFlow id="ToBe_Flow_7" sourceRef="ToBe_Start_ProblemNoticed" targetRef="ToBe_Gateway_MergeCritical" />
    <bpmn:sequenceFlow id="ToBe_Flow_8" sourceRef="ToBe_Gateway_MergeCritical" targetRef="ToBe_Task_OpenAssetDetail" />
    <bpmn:sequenceFlow id="ToBe_Flow_9" sourceRef="ToBe_Task_OpenAssetDetail" targetRef="ToBe_Task_AssessJob" />
    <bpmn:sequenceFlow id="ToBe_Flow_10" sourceRef="ToBe_Task_AssessJob" targetRef="ToBe_Gateway_DoItMyself" />
    <bpmn:sequenceFlow id="ToBe_Flow_11" name="Yes" sourceRef="ToBe_Gateway_DoItMyself" targetRef="ToBe_Task_ServiceOnFarm" />
    <bpmn:sequenceFlow id="ToBe_Flow_12" sourceRef="ToBe_Task_ServiceOnFarm" targetRef="ToBe_Gateway_MergeOutcomes" />
    <bpmn:sequenceFlow id="ToBe_Flow_13" name="No" sourceRef="ToBe_Gateway_DoItMyself" targetRef="ToBe_Task_SendFlagReasons" />
    <bpmn:sequenceFlow id="ToBe_Flow_14" sourceRef="ToBe_Task_SendFlagReasons" targetRef="ToBe_Task_BringMachine" />
    <bpmn:sequenceFlow id="ToBe_Flow_15" sourceRef="ToBe_Task_BringMachine" targetRef="ToBe_Event_MachineRepaired" />
    <bpmn:sequenceFlow id="ToBe_Flow_16" sourceRef="ToBe_Event_MachineRepaired" targetRef="ToBe_Task_CollectMachine" />
    <bpmn:sequenceFlow id="ToBe_Flow_17" sourceRef="ToBe_Task_CollectMachine" targetRef="ToBe_Gateway_MergeOutcomes" />
    <bpmn:sequenceFlow id="ToBe_Flow_18" sourceRef="ToBe_Gateway_MergeOutcomes" targetRef="ToBe_Task_PlanMachineUse" />
    <bpmn:sequenceFlow id="ToBe_Flow_19" sourceRef="ToBe_Task_PlanMachineUse" targetRef="ToBe_End_UsePlanned" />
    <bpmn:textAnnotation id="ToBe_Annotation_Repeat">
      <bpmn:text>Repeated for each asset in rank order, from this gateway to the merge before planning machine use.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="ToBe_Annotation_Intervals">
      <bpmn:text>Manufacturer service intervals are not part of AgriFleet: the hour-meter check of the as-is process continues unchanged.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="ToBe_Annotation_Records">
      <bpmn:text>Usage is recorded automatically (counters, hourly history). Performed maintenance is still not recorded.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="ToBe_Association_1" sourceRef="ToBe_Gateway_AssetStatus" targetRef="ToBe_Annotation_Repeat" />
    <bpmn:association id="ToBe_Association_2" sourceRef="ToBe_Task_CheckFleet" targetRef="ToBe_Annotation_Intervals" />
    <bpmn:association id="ToBe_Association_3" sourceRef="ToBe_End_UsePlanned" targetRef="ToBe_Annotation_Records" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="ToBe_Diagram">
    <bpmndi:BPMNPlane id="ToBe_Plane" bpmnElement="ToBe_Collaboration">
      <bpmndi:BPMNShape id="ToBe_Participant_Farmer_di" bpmnElement="ToBe_Participant_Farmer" isHorizontal="true">
        <dc:Bounds x="150" y="60" width="2000" height="440" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ToBe_Participant_AgriFleet_di" bpmnElement="ToBe_Participant_AgriFleet" isHorizontal="true">
        <dc:Bounds x="150" y="560" width="2000" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ToBe_Participant_Workshop_di" bpmnElement="ToBe_Participant_Workshop" isHorizontal="true">
        <dc:Bounds x="150" y="660" width="2000" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ToBe_Start_Morning_di" bpmnElement="ToBe_Start_Morning">
        <dc:Bounds x="232" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ToBe_Task_CheckFleet_di" bpmnElement="ToBe_Task_CheckFleet">
        <dc:Bounds x="330" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ToBe_Gateway_AssetStatus_di" bpmnElement="ToBe_Gateway_AssetStatus" isMarkerVisible="true">
        <dc:Bounds x="505" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ToBe_Task_PlanInspection_di" bpmnElement="ToBe_Task_PlanInspection">
        <dc:Bounds x="630" y="70" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ToBe_Gateway_MergeCritical_di" bpmnElement="ToBe_Gateway_MergeCritical" isMarkerVisible="true">
        <dc:Bounds x="655" y="265" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ToBe_Start_ProblemNoticed_di" bpmnElement="ToBe_Start_ProblemNoticed">
        <dc:Bounds x="662" y="382" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ToBe_Task_OpenAssetDetail_di" bpmnElement="ToBe_Task_OpenAssetDetail">
        <dc:Bounds x="780" y="250" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ToBe_Task_AssessJob_di" bpmnElement="ToBe_Task_AssessJob">
        <dc:Bounds x="930" y="250" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ToBe_Gateway_DoItMyself_di" bpmnElement="ToBe_Gateway_DoItMyself" isMarkerVisible="true">
        <dc:Bounds x="1105" y="265" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ToBe_Task_ServiceOnFarm_di" bpmnElement="ToBe_Task_ServiceOnFarm">
        <dc:Bounds x="1230" y="250" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ToBe_Task_SendFlagReasons_di" bpmnElement="ToBe_Task_SendFlagReasons">
        <dc:Bounds x="1230" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ToBe_Task_BringMachine_di" bpmnElement="ToBe_Task_BringMachine">
        <dc:Bounds x="1380" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ToBe_Event_MachineRepaired_di" bpmnElement="ToBe_Event_MachineRepaired">
        <dc:Bounds x="1562" y="382" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ToBe_Task_CollectMachine_di" bpmnElement="ToBe_Task_CollectMachine">
        <dc:Bounds x="1680" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ToBe_Gateway_MergeOutcomes_di" bpmnElement="ToBe_Gateway_MergeOutcomes" isMarkerVisible="true">
        <dc:Bounds x="1705" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ToBe_Task_PlanMachineUse_di" bpmnElement="ToBe_Task_PlanMachineUse">
        <dc:Bounds x="1830" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ToBe_End_UsePlanned_di" bpmnElement="ToBe_End_UsePlanned">
        <dc:Bounds x="2012" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ToBe_Annotation_Repeat_di" bpmnElement="ToBe_Annotation_Repeat">
        <dc:Bounds x="400" y="330" width="240" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ToBe_Annotation_Intervals_di" bpmnElement="ToBe_Annotation_Intervals">
        <dc:Bounds x="200" y="70" width="260" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ToBe_Annotation_Records_di" bpmnElement="ToBe_Annotation_Records">
        <dc:Bounds x="1960" y="70" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="ToBe_Flow_1_di" bpmnElement="ToBe_Flow_1">
        <di:waypoint x="268" y="200" />
        <di:waypoint x="330" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Flow_2_di" bpmnElement="ToBe_Flow_2">
        <di:waypoint x="430" y="200" />
        <di:waypoint x="505" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Flow_3_di" bpmnElement="ToBe_Flow_3">
        <di:waypoint x="530" y="225" />
        <di:waypoint x="530" y="290" />
        <di:waypoint x="655" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Flow_4_di" bpmnElement="ToBe_Flow_4">
        <di:waypoint x="530" y="175" />
        <di:waypoint x="530" y="110" />
        <di:waypoint x="630" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Flow_5_di" bpmnElement="ToBe_Flow_5">
        <di:waypoint x="730" y="110" />
        <di:waypoint x="1730" y="110" />
        <di:waypoint x="1730" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Flow_6_di" bpmnElement="ToBe_Flow_6">
        <di:waypoint x="555" y="200" />
        <di:waypoint x="1705" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Flow_7_di" bpmnElement="ToBe_Flow_7">
        <di:waypoint x="680" y="382" />
        <di:waypoint x="680" y="315" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Flow_8_di" bpmnElement="ToBe_Flow_8">
        <di:waypoint x="705" y="290" />
        <di:waypoint x="780" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Flow_9_di" bpmnElement="ToBe_Flow_9">
        <di:waypoint x="880" y="290" />
        <di:waypoint x="930" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Flow_10_di" bpmnElement="ToBe_Flow_10">
        <di:waypoint x="1030" y="290" />
        <di:waypoint x="1105" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Flow_11_di" bpmnElement="ToBe_Flow_11">
        <di:waypoint x="1155" y="290" />
        <di:waypoint x="1230" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Flow_12_di" bpmnElement="ToBe_Flow_12">
        <di:waypoint x="1330" y="290" />
        <di:waypoint x="1700" y="290" />
        <di:waypoint x="1730" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Flow_13_di" bpmnElement="ToBe_Flow_13">
        <di:waypoint x="1130" y="315" />
        <di:waypoint x="1130" y="400" />
        <di:waypoint x="1230" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Flow_14_di" bpmnElement="ToBe_Flow_14">
        <di:waypoint x="1330" y="400" />
        <di:waypoint x="1380" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Flow_15_di" bpmnElement="ToBe_Flow_15">
        <di:waypoint x="1480" y="400" />
        <di:waypoint x="1562" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Flow_16_di" bpmnElement="ToBe_Flow_16">
        <di:waypoint x="1598" y="400" />
        <di:waypoint x="1680" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Flow_17_di" bpmnElement="ToBe_Flow_17">
        <di:waypoint x="1730" y="360" />
        <di:waypoint x="1730" y="225" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Flow_18_di" bpmnElement="ToBe_Flow_18">
        <di:waypoint x="1755" y="200" />
        <di:waypoint x="1830" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Flow_19_di" bpmnElement="ToBe_Flow_19">
        <di:waypoint x="1930" y="200" />
        <di:waypoint x="2012" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Association_1_di" bpmnElement="ToBe_Association_1">
        <di:waypoint x="517" y="213" />
        <di:waypoint x="470" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Association_2_di" bpmnElement="ToBe_Association_2">
        <di:waypoint x="380" y="160" />
        <di:waypoint x="380" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Association_3_di" bpmnElement="ToBe_Association_3">
        <di:waypoint x="2033" y="183" />
        <di:waypoint x="2045" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Message_1_di" bpmnElement="ToBe_Message_1">
        <di:waypoint x="380" y="560" />
        <di:waypoint x="380" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Message_2_di" bpmnElement="ToBe_Message_2">
        <di:waypoint x="830" y="560" />
        <di:waypoint x="830" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Message_3_di" bpmnElement="ToBe_Message_3">
        <di:waypoint x="1280" y="440" />
        <di:waypoint x="1280" y="660" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="ToBe_Message_4_di" bpmnElement="ToBe_Message_4">
        <di:waypoint x="1580" y="660" />
        <di:waypoint x="1580" y="418" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
